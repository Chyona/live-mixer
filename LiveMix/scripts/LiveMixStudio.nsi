; LiveMix Studio Windows installer (NSIS 3.x).
;
; Required defines (normally generated by scripts/pack-windows.ps1):
;   APP_VERSION      e.g. 1.0.0
;   VI_VERSION       e.g. 1.0.0.0
;   APP_SOURCE_DIR   staged application directory
;   OUT_FILE         output installer path
;
; The staged directory contains Qt runtime files, LiveMixStudio.exe,
; ffmpeg.exe and ffprobe.exe, so the installer ships FFmpeg automatically.

Unicode true

!include "MUI2.nsh"
!include "FileFunc.nsh"

!ifndef APP_VERSION
  !define APP_VERSION "1.0.0"
!endif
!ifndef VI_VERSION
  !define VI_VERSION "1.0.0.0"
!endif
!ifndef APP_SOURCE_DIR
  !error "APP_SOURCE_DIR is required"
!endif
!ifndef OUT_FILE
  !define OUT_FILE "LiveMixStudio-${APP_VERSION}-win64-setup.exe"
!endif

Name "LiveMix Studio"
OutFile "${OUT_FILE}"
InstallDir "$PROGRAMFILES64\LiveMix Studio"
RequestExecutionLevel admin
SetCompressor /SOLID lzma
SetCompressorDictSize 64
BrandingText "LiveMix Studio"

VIProductVersion "${VI_VERSION}"
VIAddVersionKey /LANG=2052 "ProductName" "LiveMix Studio"
VIAddVersionKey /LANG=2052 "ProductVersion" "${APP_VERSION}"
VIAddVersionKey /LANG=2052 "CompanyName" "LiveMix"
VIAddVersionKey /LANG=2052 "FileDescription" "LiveMix Studio Installer"
VIAddVersionKey /LANG=2052 "FileVersion" "${VI_VERSION}"
VIAddVersionKey /LANG=2052 "LegalCopyright" "Copyright (c) LiveMix"

!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "SimpChinese"

Section "LiveMix Studio" SecMain
  SetShellVarContext all
  SetRegView 64

  SetOutPath "$INSTDIR"
  File /r "${APP_SOURCE_DIR}\*"

  WriteUninstaller "$INSTDIR\Uninstall.exe"

  CreateDirectory "$SMPROGRAMS\LiveMix Studio"
  CreateShortcut "$SMPROGRAMS\LiveMix Studio\LiveMix Studio.lnk" "$INSTDIR\LiveMixStudio.exe"
  CreateShortcut "$DESKTOP\LiveMix Studio.lnk" "$INSTDIR\LiveMixStudio.exe"

  WriteRegStr HKLM "Software\LiveMix Studio" "InstallDir" "$INSTDIR"

  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "DisplayName" "LiveMix Studio"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "DisplayVersion" "${APP_VERSION}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "Publisher" "LiveMix"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "DisplayIcon" "$INSTDIR\LiveMixStudio.exe"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "QuietUninstallString" '"$INSTDIR\Uninstall.exe" /S'
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "NoModify" 1
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "NoRepair" 1

  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio" "EstimatedSize" "$0"
SectionEnd

Section "Uninstall"
  SetShellVarContext all
  SetRegView 64

  Delete "$DESKTOP\LiveMix Studio.lnk"
  Delete "$SMPROGRAMS\LiveMix Studio\LiveMix Studio.lnk"
  RMDir "$SMPROGRAMS\LiveMix Studio"

  RMDir /r "$INSTDIR"

  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\LiveMixStudio"
  DeleteRegKey HKLM "Software\LiveMix Studio"
SectionEnd
