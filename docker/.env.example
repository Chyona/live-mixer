# 敏感配置模板：复制为 .env 后填写真实值，勿提交 Git
# 变量名与程序 APP_* 一致；优先级高于 docker-compose.yaml 中的非敏感项与内嵌 config.yaml

# ── 数据库（连接地址 / 账号）──────────────────────────────────────────────
# PostgreSQL 主机地址；Docker 内访问宿主机可用 host.docker.internal，同 compose 网络内填服务名
APP_DATABASE_HOST=127.0.0.1
# PostgreSQL 端口，默认 5432
APP_DATABASE_PORT=5432
# 数据库用户名
APP_DATABASE_USER=live_mixer
# 数据库名
APP_DATABASE_DBNAME=live_mixer
# 数据库密码（生产环境务必修改为强密码）
APP_DATABASE_PASSWORD=change-me

# ── JWT 鉴权 ──────────────────────────────────────────────────────────────
# JWT 签名密钥（生产环境务必修改为随机长字符串）；Token 有效期见 compose 中 APP_JWT_EXPIRES_IN
APP_JWT_SECRET=change-me-jwt-secret

# ── 对象存储（COS > OSS > TOS）────────────────────────────────────────────
# 同时配置多个后端时按 COS > OSS > TOS 选择；仅配置其中一组完整项即可启用对应后端
# 未配置任何可用后端时，上传相关功能不可用

# 对象存储上传目录前缀（根目录），COS / OSS / TOS 共用。
# 上传时传入相对对象键，客户端自动拼接为完整 object key：[前缀/]相对路径。
# 首尾多余的 / 会自动去除。
#
# 约定子目录（相对 base_path）：
#   temp/  临时文件（ASR 前上传获取公网 URL 等）
#   test/  cmd/test 进程产生的测试上传（单元测试不受此约定约束）
#
# 配置示例（环境变量 APP_STORAGE_BASE_PATH；未设置时使用内嵌 config.yaml 的 storage.base_path，默认 video_editing）：
#   未设置           -> video_editing/temp/asr_{uuid}.mp3（ASR 临时音频）
#                     -> video_editing/test/main.go（cmd/test 默认上传）
#   video_editing    -> video_editing/temp/asr_{uuid}.mp3
#   prod/live-mixer  -> prod/live-mixer/test/main.go
#   /video_editing/  -> video_editing/test/main.go（与上相同）
APP_STORAGE_BASE_PATH=

# 上传后返回的签名链接有效期（天）；未设置时使用内嵌 config.yaml 默认值 30（TOS 最长 7 天）
APP_STORAGE_SIGNED_URL_EXPIRE_DAYS=30

# 腾讯云 COS SecretId（控制台 API 密钥管理获取）
APP_STORAGE_COS_SECRET_ID=
# 腾讯云 COS SecretKey
APP_STORAGE_COS_SECRET_KEY=
# COS 存储桶名称，例如 my-bucket-1250000000
APP_STORAGE_COS_BUCKET_NAME=
# COS 地域，例如 ap-guangzhou、ap-shanghai
APP_STORAGE_COS_REGION=

# 阿里云 OSS AccessKeyId（COS 未配置完整时作为兜底）
APP_STORAGE_OSS_ACCESS_KEY_ID=
# 阿里云 OSS AccessKeySecret
APP_STORAGE_OSS_ACCESS_KEY_SECRET=
# OSS 存储桶名称
APP_STORAGE_OSS_BUCKET_NAME=
# OSS 访问域名，例如 oss-cn-hangzhou.aliyuncs.com（不含 https://）
APP_STORAGE_OSS_ENDPOINT=

# 火山引擎 TOS AccessKeyId（COS、OSS 均未配置完整时作为兜底）
APP_STORAGE_TOS_ACCESS_KEY_ID=
# 火山引擎 TOS AccessKeySecret
APP_STORAGE_TOS_ACCESS_KEY_SECRET=
# TOS 存储桶名称
APP_STORAGE_TOS_BUCKET_NAME=
# TOS 地域，例如 cn-beijing、cn-shanghai
APP_STORAGE_TOS_REGION=
# TOS 访问域名（可选，未设置时按地域自动生成，例如 tos-cn-beijing.volces.com）
APP_STORAGE_TOS_ENDPOINT=

# ── 豆包语音识别（ASR）────────────────────────────────────────────────────
# 火山引擎豆包 ASR API Key；未设置时使用内嵌 config.yaml 默认值
APP_ASR_API_KEY=
# ASR API 地址（可选）
APP_ASR_BASE_URL=
# ASR 资源 ID（可选，默认 volc.seedasr.auc）
APP_ASR_RESOURCE_ID=
# 轮询间隔秒数（可选）
APP_ASR_POLL_INTERVAL_SEC=
# 最大轮询次数（可选）
APP_ASR_MAX_POLLS=

# ── OpenAI 兼容大模型 ──────────────────────────────────────────────────────
# DashScope / 其它 OpenAI 兼容接口的 API Key
APP_LLM_API_KEY=
# Chat Completions 基础地址（可选，默认 https://dashscope.aliyuncs.com/compatible-mode/v1）
APP_LLM_BASE_URL=
# 默认模型（AI 切片等；可选，默认 qwen3.7-plus）
APP_LLM_MODEL=
# ASR 后处理轻量模型（添加视频后初始化 asr_summaries/asr_paragraphs；可选，默认 qwen3.7-flash）
APP_LLM_FLASH_MODEL=

# ── 后台 Worker 调度 ───────────────────────────────────────────────────────
# 单实例同时执行的 AI 切片任务数（可选，默认 6）
APP_WORKER_AI_SLICE_CONCURRENCY=6
# 单实例同时执行的直播素材 ASR 任务数（可选，默认 6）
APP_WORKER_ASR_CONCURRENCY=6
# 单实例同时执行的剪映草稿任务数（可选，默认 3）
APP_WORKER_DRAFT_CONCURRENCY=3
# 单实例同时执行的一键成片任务数（可选，默认 3）
APP_WORKER_AI_SLICE_DRAFT_CONCURRENCY=3
# processing 孤儿回收超时（分钟）：超时未更新心跳则改回 pending 重新排队
# ASR 默认 60；AI 切片默认 20；草稿默认 60；一键成片默认 90
APP_WORKER_ASR_STALE_TIMEOUT_MIN=30
APP_WORKER_AI_SLICE_STALE_TIMEOUT_MIN=20
APP_WORKER_DRAFT_STALE_TIMEOUT_MIN=20
APP_WORKER_AI_SLICE_DRAFT_STALE_TIMEOUT_MIN=30

# ── 剪映草稿（capcut-mate）─────────────────────────────────────────────────
# capcut-mate REST API 根地址（也可用 CAPCUT_MATE_URL）；默认 http://192.168.3.219:81
APP_CAPCUT_MATE_BASE_URL=http://nginx
# 可选：gen_video / gen_video_status 共用根地址；未设置时走 BASE_URL
# APP_CAPCUT_MATE_GEN_VIDEO_BASE_URL=https://capcut-mate.jcaigc.cn
# 是否启用 gen_video（默认 true；false/0/off 时跳过视频生成，草稿完成后直接标记完成）
# APP_CAPCUT_MATE_ENABLE_GEN_VIDEO=true
# 视频生成（gen_video）API 密钥（也可用 CAPCUT_MATE_API_KEY）
APP_CAPCUT_MATE_API_KEY=
# 视频生成状态轮询间隔（秒；默认 5）与最大次数（默认 360，约 30 分钟）
# APP_CAPCUT_MATE_GEN_VIDEO_POLL_INTERVAL_SEC=5
# APP_CAPCUT_MATE_GEN_VIDEO_MAX_POLLS=360
# 本地暂存根目录：任务切片落盘到 {dir}/staging/{task_id}/（也可用 WEB_ROOT_DIR）
# 切片对外访问 URL 由对象存储上传返回，不再需要 APP_WEB_ROOT_URL
APP_WEB_ROOT_DIR=/app/html
# staging 最多保留的任务子目录数；按 mtime 保留最新，超出删除最旧（默认 80）
APP_WEB_STAGING_MAX_DIRS=80
# staging 清理任务执行间隔（分钟；默认 60）
APP_WEB_STAGING_CLEANUP_INTERVAL_MIN=60

# ── 远程文件下载（内网加速）────────────────────────────────────────────────
# 下载前将 URL Host 精确替换为内网域名；仅影响服务端下载，不改数据库/API 返回值。
# 规则格式：from->to；多条规则写在同一行，用英文逗号 , 分隔。
#
# 精确 Host 映射示例：
#   单条：APP_DOWNLOAD_HOST_MAPPINGS=arkclaw-wxbpd.tos-cn-shanghai.volces.com->arkclaw-wxbpd.tos-cn-shanghai.ivolces.com
#   多条：APP_DOWNLOAD_HOST_MAPPINGS=arkclaw-wxbpd.tos-cn-shanghai.volces.com->arkclaw-wxbpd.tos-cn-shanghai.ivolces.com,other-bucket.tos-cn-beijing.volces.com->other-bucket.tos-cn-beijing.ivolces.com
APP_DOWNLOAD_HOST_MAPPINGS=arkclaw-wxbpd.tos-cn-shanghai.volces.com->arkclaw-wxbpd.tos-cn-shanghai.ivolces.com
